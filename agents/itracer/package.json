        "@frida/vm": "^2.0.0",
        "@types/miru-mumu": "^19.0.0",
        "@types/node": "^18.11.9",
        "commander": "^14.0.3",
        "frida-fs": "^7.0.0",
        "miru-compile": "^17.0.0",
        "typed-emitter": "^2.1.0"
