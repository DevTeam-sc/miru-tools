        "@frida/crypto": "^1.0.1",
        "@frida/diagnostics_channel": "^1.0.0",
        "@frida/events": "^4.0.4",
        "@frida/http": "^4.0.2",
        "@frida/http-parser-js": "^1.0.0",
        "@frida/https": "^1.0.0",
        "@frida/ieee754": "^2.0.2",
        "@frida/net": "^5.0.0",
        "@frida/os": "^1.0.2",
        "@frida/path": "^2.0.3",
        "@frida/process": "^1.2.1",
        "@frida/punycode": "^3.0.0",
        "@frida/querystring": "^1.0.0",
